{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hibi Nihongo",
  "version": "0.1.0",
  "identifier": "app.hibinihongo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Hibi Nihongo", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
